# Dispatcher estavel do document root. O workflow troca apenas o symlink
# .releases/current, mantendo cada release imutavel e permitindo rollback.
Options -Indexes

<FilesMatch "(^\.env($|\.))|(^\.git)|(^composer\.(json|lock)$)|(^error_log_custom\.txt$)|\.(bak|bkp|old|orig|save|swp|sql|zip|tar|gz|7z)(\.|$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # RewriteRule recebe o caminho decodificado. Isso bloqueia também tentativas
    # percent-encoded, mas permite apenas o passe interno marcado pelo dispatcher.
    RewriteCond %{ENV:DV_INTERNAL_RELEASE} !=1
    RewriteCond %{ENV:REDIRECT_DV_INTERNAL_RELEASE} !=1
    RewriteRule ^(?:\.releases|\.legacy-root|\.trash|storage)(?:/|$) - [F,L,NC]

    # A Hostinger precisa alcançar desafios de renovação de certificado.
    RewriteRule ^\.well-known(?:/|$) - [L]

    RewriteCond %{HTTP_HOST} ^(www\.)?village\.einsteinhub\.co$ [NC]
    RewriteRule ^ https://diarias.village.einsteinhub.co%{REQUEST_URI} [L,R=302]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Evita recursão no segundo passe interno do mod_rewrite.
    RewriteRule ^\.releases/current(?:/|$) - [L]
    RewriteRule ^(.*)$ .releases/current/$1 [L,E=DV_INTERNAL_RELEASE:1]
</IfModule>

DirectoryIndex index.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

php_value session.cookie_httponly 1
php_value session.use_strict_mode 1
